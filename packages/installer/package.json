    "test": "vitest run"
  },
  "dependencies": {
    "@nova-cbb/harness-contracts": "workspace:*",
    "@nova-cbb/harness-shared": "workspace:*",
    "tar": "^7.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3"
  }
}
