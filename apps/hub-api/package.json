    "@nova-cbb/harness-contracts": "workspace:*",
    "@nova-cbb/harness-core": "workspace:*",
    "@nova-cbb/harness-shared": "workspace:*",
    "@nova-cbb/source-gitlab": "workspace:*",
    "@nova-cbb/source-npm": "workspace:*",
    "@prisma/client": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
